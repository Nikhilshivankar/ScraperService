# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///./scraper_service.db

# Scraper Configuration
REQUEST_TIMEOUT=15
MAX_RETRIES=2
RATE_LIMIT_DELAY=0.5

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
